{
  "schema_version": 1,
  "kind": "nix-skill",
  "id": "opendeck",
  "name": "OpenDeck",
  "version": "1.23.0",
  "description": "Play the music in a self-hosted OpenDeck server: search, play a requested song on the unit, keep a shuffle/repeat queue, like or file the playing track, and fill the console's Music page with now-playing, the queue and synchronized lyrics. Ships the PUCA Panel: the wall display, where an unclear request becomes a choice rather than a guess, the music cards are sized to be read across a room (the player is not), and a wall left on refreshes itself onto a new panel.",
  "assistant_summary": "You are OpenDeck, the user's music service. Actions: search (query), now_playing, library (kind: playlists/playlist/likes/history/frequent/stats), play (query or video_id), queue (op: add/list/remove/clear/next/play/move/front/next_up/shuffle/repeat/add_range), save (like/unlike/playlist_create/playlist_add), lyrics. 'my playlists' is kind 'playlists' (artwork_url), 'my liked songs' 'likes', 'my history' 'history', 'my most played' / 'what do I play most' 'frequent' (each track has its play count). Queue: 'queue <song>' / 'add <song> to my queue' are 'add'; \"what's in my queue\" is 'list'; 'play <song> next/first' are 'next_up'/'front'; 'play the next queued track' is 'next'; 'remove <song> from the queue' is 'remove'; 'clear the queue' is 'clear'; shuffle/repeat are 'shuffle'/'repeat' (omit to toggle). 'like this song' / 'add this to my liked music' are 'like'; 'add this to <playlist>' is 'playlist_add' with name=<playlist> (found or created); 'this song' is the one playing, so no video_id. Never add to Liked Music (\"LM\"); that is 'like'. \"what's playing\" is 'now_playing'; 'search for <song>' is 'search', not 'play'; use 'play' only when asked. It also fills the Music page.",
  "category": "Music",
  "publisher": "NIX Community Skills",
  "license": "MIT",
  "icon": "♫",
  "tags": [
    "music",
    "opendeck",
    "youtube-music",
    "player",
    "self-hosted",
    "Music",
    "Media",
    "Lyrics"
  ],
  "permissions": [
    "Read the linked YouTube Music account's library (playlists, liked songs) through the OpenDeck server it is linked to.",
    "Read and write the configured OpenDeck account's library through its HTTP API using the stored API key.",
    "Resolve playable audio stream URLs through the OpenDeck server's own catalog and media endpoints.",
    "Run the installed worker subprocess with the NIX user's OS permissions; this is not sandboxed.",
    "Serve the declared music page assets (ui/music.js, ui/music.css) to the NIX console dashboard; that code runs at the console origin, under the same explicit digest trust as the worker.",
    "Answer the console music API (now playing, search, play, library, lyrics, play queue) for the dashboard and the paired NIX Home mobile app.",
    "Keep a play queue of requested tracks in a small JSON file under the NIX data directory.",
    "Fetch synchronized lyrics from LRCLIB through the configured OpenDeck server's allowlisted proxy."
  ],
  "setup_fields": [
    {
      "id": "server_url",
      "label": "OpenDeck server address",
      "type": "string",
      "required": true,
      "help": "Address of the OpenDeck instance, e.g. http://192.168.0.152:4100 or https://music.example.com. Include the port if it is not 80/443."
    },
    {
      "id": "api_key",
      "label": "OpenDeck API key",
      "type": "string",
      "required": true,
      "help": "Create one under Settings → API; it looks like odk_… NIX's secret field only takes 32-byte base64 device keys, so this key is stored as plain setup text in the skill's private 0600 config file."
    }
  ],
  "runtime": {
    "protocol": "nix-skill-jsonl-v1",
    "entrypoint": "opendeck_worker.py",
    "autostart": false
  },
